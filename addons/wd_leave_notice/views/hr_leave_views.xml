<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_wd_import" model="ir.ui.view">
        <field name="name">hr.leave.form.wd.import.warning</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning" role="alert"
                     invisible="not wd_import_warning">
                    <field name="wd_import_warning" nolabel="1"
                           readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

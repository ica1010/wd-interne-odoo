<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Groupes métier (R11) -->
    <record id="module_category_wd_it" model="ir.module.category">
        <field name="name">Demandes IT</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_it_technician" model="res.groups">
        <field name="name">Technicien IT</field>
        <field name="category_id" ref="module_category_wd_it"/>
        <field name="implied_ids"
            eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_it_manager" model="res.groups">
        <field name="name">Responsable IT</field>
        <field name="category_id" ref="module_category_wd_it"/>
        <field name="implied_ids"
            eval="[(4, ref('wd_it_request.group_it_technician'))]"/>
    </record>

    <!-- Les gestionnaires d'équipements existants sont des
         techniciens IT de fait. -->
    <record id="maintenance.group_equipment_manager"
            model="res.groups">
        <field name="implied_ids"
            eval="[(4, ref('wd_it_request.group_it_technician'))]"/>
    </record>

    <!-- Règles d'enregistrement (R11) :
         - tout utilisateur interne voit et modifie SES demandes ;
         - le technicien voit et modifie TOUTES les demandes ;
         - le responsable IT (et l'administrateur) a tout,
           suppression comprise ;
         - les demandes sans employé lié à un compte restent
           visibles des techniciens/managers. -->

    <record id="rule_it_request_own" model="ir.rule">
        <field name="name">Demande IT : ses propres demandes</field>
        <field name="model_id" ref="model_wd_it_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_it_request_technician" model="ir.rule">
        <field name="name">Demande IT : technicien (toutes)</field>
        <field name="model_id" ref="model_wd_it_request"/>
        <field name="groups" eval="[
            (4, ref('wd_it_request.group_it_technician')),
            (4, ref('base.group_system')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_it_request_manager" model="ir.rule">
        <field name="name">Demande IT : responsable IT (tout)</field>
        <field name="model_id" ref="model_wd_it_request"/>
        <field name="groups" eval="[
            (4, ref('wd_it_request.group_it_manager')),
            (4, ref('base.group_system')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Lignes : mêmes périmètres via la demande parente -->
    <record id="rule_it_request_line_own" model="ir.rule">
        <field name="name">Ligne demande IT : ses propres demandes</field>
        <field name="model_id" ref="model_wd_it_request_line"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('employee_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_it_request_line_technician" model="ir.rule">
        <field name="name">Ligne demande IT : technicien (toutes)</field>
        <field name="model_id" ref="model_wd_it_request_line"/>
        <field name="groups" eval="[
            (4, ref('wd_it_request.group_it_technician')),
            (4, ref('base.group_system')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_it_request_line_manager" model="ir.rule">
        <field name="name">Ligne demande IT : responsable IT (tout)</field>
        <field name="model_id" ref="model_wd_it_request_line"/>
        <field name="groups" eval="[
            (4, ref('wd_it_request.group_it_manager')),
            (4, ref('base.group_system')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Référence automatique IT/2026/00001 -->
    <record id="seq_it_request" model="ir.sequence">
        <field name="name">Demande IT</field>
        <field name="code">wd.it.request</field>
        <field name="prefix">IT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Cron quotidien : clôture J+3 + alerte retards (R14) -->
    <record id="cron_close_and_notify" model="ir.cron">
        <field name="name">Demandes IT : clôture J+3 et alertes SLA</field>
        <field name="model_id" ref="model_wd_it_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_and_notify_late()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
